{
  "name": "body-measure",
  "private": true,
  "version": "2.0.0",
  "description": "Tailoring measurements from two phone photos, using in-browser pose estimation.",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-mediapipe.mjs",
    "dev": "vite",
